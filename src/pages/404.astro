---
import { Icon } from "astro-icon/components";
import MainGridLayout from "../layouts/MainGridLayout.astro";
import { url } from "../utils/url-utils";
---

<MainGridLayout title="404 Not Found" description="页面未找到">
	<div class="flex w-full rounded-[1.75rem] overflow-hidden relative min-h-32">
		<div class="z-10 px-6 md:px-10 py-10 md:py-16 relative w-full rounded-[1.75rem] bg-[var(--md-sys-color-surface-container-low)] shadow-md-1 transition text-center">
			<!-- 404 large number -->
			<div class="onload-animation select-none">
				<span class="text-[8rem] md:text-[10rem] font-bold leading-none tracking-tighter bg-gradient-to-b from-[var(--md-sys-color-primary)] to-[var(--md-sys-color-tertiary)] bg-clip-text text-transparent">
					404
				</span>
			</div>

			<!-- message -->
			<div class="onload-animation mt-2 mb-8">
				<h1 class="text-xl md:text-2xl font-bold text-[var(--md-sys-color-on-surface)] mb-2">
					页面未找到
				</h1>
				<p class="text-sm md:text-base text-[var(--md-sys-color-on-surface-variant)] max-w-md mx-auto leading-relaxed">
					你访问的页面可能已被移动、删除，或你输入的地址有误。
				</p>
			</div>

			<!-- action buttons -->
			<div class="onload-animation flex flex-col sm:flex-row items-center justify-center gap-3">
				<a href={url("/")}
				   class="flex items-center gap-2 px-6 h-11 rounded-2xl font-medium text-sm transition
				          bg-[var(--md-sys-color-primary)] text-[var(--md-sys-color-on-primary)]
				          hover:shadow-md-2 active:scale-[0.97]">
					<Icon name="material-symbols:home-outline-rounded" class="text-[1.25rem]" />
					返回首页
				</a>
				<a href={url("/archive/")}
				   class="flex items-center gap-2 px-6 h-11 rounded-2xl font-medium text-sm transition md3-state-layer
				          bg-[var(--md-sys-color-secondary-container)] text-[var(--md-sys-color-on-secondary-container)]
				          hover:shadow-md-1 active:scale-[0.97]">
					<Icon name="material-symbols:archive-outline-rounded" class="text-[1.25rem]" />
					浏览归档
				</a>
			</div>

			<!-- decorative divider -->
			<div class="onload-animation mt-10 flex items-center justify-center gap-3 text-[var(--md-sys-color-outline-variant)]">
				<div class="h-px w-8 bg-[var(--md-sys-color-outline-variant)]"></div>
				<Icon name="material-symbols:search-rounded" class="text-[1rem]" />
				<span class="text-xs">试试搜索你想找的内容</span>
				<div class="h-px w-8 bg-[var(--md-sys-color-outline-variant)]"></div>
			</div>
		</div>
	</div>
</MainGridLayout>
