---
import { Icon } from "astro-icon/components";
import { readFileSync } from "node:fs";
import { join } from "node:path";
import { parse } from "yaml";
import I18nKey from "../i18n/i18nKey";
import { i18n } from "../i18n/translation";
import MainGridLayout from "../layouts/MainGridLayout.astro";

// 读取并解析 friends.yml
const ymlPath = join(process.cwd(), "public", "data", "friends.yml");
const ymlContent = readFileSync(ymlPath, "utf-8");
const friends = parse(ymlContent).map((item: any) => ({
    name: item.Name,
    url: item.URL,
    icon: item.Icon,
    desc: item.Desc,
}));
---
<MainGridLayout title={i18n(I18nKey.friends)} description={i18n(I18nKey.friends)}>
    <div class="flex w-full rounded-2xl overflow-hidden relative min-h-32">
        <div class="z-10 px-6 md:px-8 py-6 relative w-full rounded-2xl bg-[var(--md-sys-color-surface-container-low)] shadow-md-1 transition">
            <h1 class="text-2xl font-bold mb-6 text-[var(--md-sys-color-on-surface)]">{i18n(I18nKey.friends)}</h1>
            <h2 class="text-xl font-bold mb-6 text-[var(--md-sys-color-on-surface)]">这是本站的友链界面，不定期更新，欢迎联系站长互换友链！</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                {friends.map((friend) => (
                    <div class:list={[
                        "group/card flex flex-col w-full rounded-[1.75rem] overflow-hidden relative transition",
                        "bg-[var(--card-bg)]",
                        "shadow-[0_1px_3px_0_rgba(0,0,0,0.06),0_1px_2px_-1px_rgba(0,0,0,0.04)]",
                        "ring-1 ring-inset ring-black/[0.03] dark:ring-white/[0.03]",
                        "hover:shadow-[0_4px_6px_-1px_rgba(0,0,0,0.08),0_2px_4px_-2px_rgba(0,0,0,0.05)]",
                    ]}>
                        <div class="px-5 md:px-7 pt-5 md:pt-6 pb-5 relative flex flex-col flex-1">
                            <a href={friend.url}
                               class="transition group/title inline-block w-fit font-bold mb-3 text-xl sm:text-2xl tracking-tight leading-snug
                                      text-[var(--md-sys-color-on-surface)]
                                      hover:text-[var(--md-sys-color-primary)]"
                            >
                                <span class="md:before:w-1 md:before:h-5 md:before:rounded-full md:before:bg-[var(--md-sys-color-primary)] md:before:absolute md:before:top-[1.6rem] md:before:left-[0.5rem]">
                                    {friend.name}
                                </span>
                                <Icon class="inline text-[1.75rem] text-[var(--md-sys-color-primary)] md:hidden ml-1 align-middle" name="material-symbols:chevron-right-rounded" />
                            </a>

                            <div class="flex items-start gap-4 mb-4">
                                <img src={friend.icon}
                                     alt={friend.name}
                                     class="w-16 h-16 rounded-2xl object-cover shrink-0 ring-1 ring-inset ring-black/[0.03] dark:ring-white/[0.03]"
                                />
                                <div class="transition text-sm leading-relaxed text-[var(--md-sys-color-on-surface-variant)] flex-1 line-clamp-3">
                                    {friend.desc}
                                </div>
                            </div>

                            <div class="flex items-center justify-end">
                                <a href={friend.url}
                                   aria-label={friend.name}
                                   class="hidden md:flex items-center justify-center absolute right-4 top-4 w-11 h-11 rounded-2xl shrink-0
                                          bg-[var(--md-sys-color-secondary-container)] text-[var(--md-sys-color-on-secondary-container)]
                                          hover:brightness-95 dark:hover:brightness-110 active:scale-95 transition"
                                   target="_blank"
                                   rel="noopener noreferrer"
                                >
                                    <Icon name="fa6-solid:arrow-up-right-from-square" class="text-lg"></Icon>
                                </a>
                            </div>

                            <a href={friend.url}
                               class="md:hidden flex items-center justify-center w-9 h-9 rounded-2xl shrink-0 mt-2 ml-auto
                                      bg-[var(--md-sys-color-secondary-container)] text-[var(--md-sys-color-on-secondary-container)]
                                      active:scale-90 transition"
                               target="_blank"
                               rel="noopener noreferrer"
                            >
                                <Icon name="material-symbols:chevron-right-rounded" class="text-xl"></Icon>
                            </a>
                        </div>
                    </div>
                ))}
            </div>
        </div>
    </div>
</MainGridLayout>