---
import { Icon } from "astro-icon/components";
import { profileConfig } from "../../config";
import { url } from "../../utils/url-utils";
import ImageWrapper from "../misc/ImageWrapper.astro";

const config = profileConfig;
---
<div class="rounded-2xl p-4 bg-[var(--md-sys-color-surface-container-low)] shadow-md-1 transition">
    <a aria-label="Go to About Page" href={url('/about/')}
       class="group block relative mx-auto mt-1 lg:mx-0 lg:mt-0 mb-4
       max-w-[8rem] lg:max-w-none overflow-hidden rounded-2xl">
        <div class="absolute transition pointer-events-none group-hover:bg-black/20 group-active:bg-black/40
        w-full h-full z-50 flex items-center justify-center">
            <Icon name="fa6-regular:address-card"
                  class="transition opacity-0 scale-90 group-hover:scale-100 group-hover:opacity-100 text-white text-5xl">
            </Icon>
        </div>
        <ImageWrapper src={config.avatar || ""} alt="Profile Image of the Author" class="mx-auto lg:w-full h-full lg:mt-0 "></ImageWrapper>
    </a>
    <div class="px-1">
        <div class="font-bold text-lg text-center mb-1 text-[var(--md-sys-color-on-surface)] transition">{config.name}</div>
        <div class="h-1 w-5 bg-[var(--md-sys-color-primary)] mx-auto rounded-full mb-2 transition"></div>
        <div class="text-center text-sm text-[var(--md-sys-color-on-surface-variant)] mb-3 transition">{config.bio}</div>
        <div class="flex flex-wrap gap-2 justify-center mb-1">
            {config.links.length > 1 && config.links.map(item =>
                    <a rel="me" aria-label={item.name} href={item.url} target="_blank" class="flex items-center justify-center rounded-xl h-10 w-10 transition
                        bg-[var(--md-sys-color-secondary-container)] text-[var(--md-sys-color-on-secondary-container)]
                        hover:bg-[var(--md-sys-color-primary-container)] hover:text-[var(--md-sys-color-on-primary-container)]">
                        <Icon name={item.icon} class="text-[1.25rem]"></Icon>
                    </a>
            )}
            {config.links.length == 1 && <a rel="me" aria-label={config.links[0].name} href={config.links[0].url} target="_blank"
                                            class="flex items-center justify-center rounded-xl h-10 gap-2 px-4 font-medium transition text-sm
                                            bg-[var(--md-sys-color-secondary-container)] text-[var(--md-sys-color-on-secondary-container)]
                                            hover:bg-[var(--md-sys-color-primary-container)] hover:text-[var(--md-sys-color-on-primary-container)]">
                <Icon name={config.links[0].icon} class="text-[1.25rem]"></Icon>
                {config.links[0].name}
            </a>}
        </div>
    </div>
</div>

