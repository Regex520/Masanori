---
import type { CollectionEntry } from "astro:content";
import path from "node:path";
import { Icon } from "astro-icon/components";
import I18nKey from "../i18n/i18nKey";
import { i18n } from "../i18n/translation";
import { getDir } from "../utils/url-utils";
import ImageWrapper from "./misc/ImageWrapper.astro";
import PostMetadata from "./PostMeta.astro";

interface Props {
	class?: string;
	entry: CollectionEntry<"posts">;
	title: string;
	url: string;
	published: Date;
	updated?: Date;
	tags: string[];
	category: string | null;
	image: string;
	description: string;
	draft: boolean;
	style: string;
}
const {
	entry,
	title,
	url,
	published,
	updated,
	tags,
	category,
	image,
	description,
	style,
} = Astro.props;
const className = Astro.props.class;

const hasCover = image !== undefined && image !== null && image !== "";

const { remarkPluginFrontmatter } = await entry.render();
---
<div class:list={["group/card flex flex-col w-full rounded-[1.75rem] overflow-hidden relative transition",
    "bg-[var(--md-sys-color-surface-container-low)]",
    "shadow-md-1 hover:shadow-md-2",
    className]} style={style}>

    <!-- Cover image - full width on mobile, side on desktop -->
    {hasCover && <a href={url} aria-label={title}
                    class="group/cover block w-full h-48 sm:h-56 md:h-44 lg:h-36 md:w-[40%] md:absolute md:right-4 md:top-4 md:bottom-4 md:z-10
                    rounded-none md:rounded-2xl overflow-hidden shrink-0 transition">
        <div class="absolute pointer-events-none z-10 w-full h-full group-hover/cover:bg-black/20 transition"></div>
        <div class="absolute pointer-events-none z-20 w-full h-full flex items-center justify-center">
            <Icon name="material-symbols:chevron-right-rounded"
                  class="transition opacity-0 group-hover/cover:opacity-100 scale-50 group-hover/cover:scale-100 text-white text-5xl">
            </Icon>
        </div>
        <ImageWrapper src={image} basePath={path.join("content/posts/", getDir(entry.id))} alt="Cover Image of the Post"
                  class="w-full h-full">
        </ImageWrapper>
    </a>}

    <!-- Content area -->
    <div class:list={["px-5 md:px-7 pt-5 md:pt-6 pb-5 relative flex flex-col flex-1", {"md:pr-[calc(40%_+_2rem)]": hasCover}]}>
        <a href={url}
           class="transition group/title inline-block w-fit font-bold mb-3 text-xl sm:text-2xl tracking-tight leading-snug
        text-[var(--md-sys-color-on-surface)]
        hover:text-[var(--md-sys-color-primary)]"
        >
            <span class:list={[{"md:before:w-1 md:before:h-5 md:before:rounded-full md:before:bg-[var(--md-sys-color-primary)] md:before:absolute md:before:top-[1.6rem] md:before:-left-[0.875rem]": hasCover, "md:before:w-1 md:before:h-5 md:before:rounded-full md:before:bg-[var(--md-sys-color-primary)] md:before:absolute md:before:top-[1.6rem] md:before:left-[0.5rem]": !hasCover}]}>
                {title}
            </span>
            <Icon class="inline text-[1.75rem] text-[var(--md-sys-color-primary)] md:hidden ml-1 align-middle" name="material-symbols:chevron-right-rounded" ></Icon>
        </a>

        <!-- metadata -->
        <PostMetadata published={published} updated={updated} tags={tags} category={category} hideTagsForMobile={false} hideUpdateDate={true} class="mb-3"></PostMetadata>

        <!-- description -->
        <div class="transition text-sm leading-relaxed text-[var(--md-sys-color-on-surface-variant)] mb-4 flex-1">
            <span class="line-clamp-2 md:line-clamp-3">{ description || remarkPluginFrontmatter.excerpt }</span>
        </div>

        <!-- bottom row: word count + enter button -->
        <div class="flex items-center justify-between">
            <div class="text-xs text-[var(--md-sys-color-outline)] flex gap-3 transition">
                <span>{remarkPluginFrontmatter.words} {" " + i18n(remarkPluginFrontmatter.words === 1 ? I18nKey.wordCount : I18nKey.wordsCount)}</span>
                <span>·</span>
                <span>{remarkPluginFrontmatter.minutes} {" " + i18n(remarkPluginFrontmatter.minutes === 1 ? I18nKey.minuteCount : I18nKey.minutesCount)}</span>
            </div>

            {!hasCover &&
                <a href={url} aria-label={title}
                   class="md:hidden flex items-center justify-center w-9 h-9 rounded-2xl shrink-0
                   bg-[var(--md-sys-color-secondary-container)] text-[var(--md-sys-color-on-secondary-container)]
                   active:scale-90 transition">
                    <Icon name="material-symbols:chevron-right-rounded" class="text-xl"></Icon>
                </a>
            }

            {!hasCover &&
                <a href={url} aria-label={title}
                   class="hidden md:flex items-center justify-center absolute right-4 top-4 w-11 h-11 rounded-2xl shrink-0
                   bg-[var(--md-sys-color-secondary-container)] text-[var(--md-sys-color-on-secondary-container)]
                   md3-state-layer-secondary transition">
                    <Icon name="material-symbols:chevron-right-rounded" class="text-2xl"></Icon>
                </a>
            }
        </div>
    </div>
</div>
