/* utils */
white(a)
  rgba(255, 255, 255, a)

black(a)
  rgba(0, 0, 0, a)

rainbow-light = linear-gradient(to right, oklch(0.80 0.10 0), oklch(0.80 0.10 30), oklch(0.80 0.10 60), oklch(0.80 0.10 90), oklch(0.80 0.10 120), oklch(0.80 0.10 150), oklch(0.80 0.10 180), oklch(0.80 0.10 210), oklch(0.80 0.10 240), oklch(0.80 0.10 270), oklch(0.80 0.10 300), oklch(0.80 0.10 330), oklch(0.80 0.10 360))
rainbow-dark = linear-gradient(to right, oklch(0.70 0.10 0), oklch(0.70 0.10 30), oklch(0.70 0.10 60), oklch(0.70 0.10 90), oklch(0.70 0.10 120), oklch(0.70 0.10 150), oklch(0.70 0.10 180), oklch(0.70 0.10 210), oklch(0.70 0.10 240), oklch(0.70 0.10 270), oklch(0.70 0.10 300), oklch(0.70 0.10 330), oklch(0.70 0.10 360))

:root
  --radius-large 1rem
  --content-delay 150ms

  /* Material You 3 Shape Tokens */
  --md-sys-shape-corner-none: 0
  --md-sys-shape-corner-extra-small: 0.25rem
  --md-sys-shape-corner-small: 0.5rem
  --md-sys-shape-corner-medium: 0.75rem
  --md-sys-shape-corner-large: 1rem
  --md-sys-shape-corner-extra-large: 1.75rem
  --md-sys-shape-corner-full: 624.9375rem

  /* Material You 3 Elevation / Surface Tonal (light mode - subtle) */
  --md-sys-elevation-level0: none
  --md-sys-elevation-level1: 0 1px 2px 0 rgba(0,0,0,0.03), 0 1px 3px 1px rgba(0,0,0,0.02)
  --md-sys-elevation-level2: 0 1px 2px 0 rgba(0,0,0,0.06), 0 2px 6px 2px rgba(0,0,0,0.04)
  --md-sys-elevation-level3: 0 4px 8px 3px rgba(0,0,0,0.06), 0 1px 3px 0 rgba(0,0,0,0.04)
  --md-sys-elevation-level4: 0 6px 10px 4px rgba(0,0,0,0.08), 0 2px 3px 0 rgba(0,0,0,0.06)
  --md-sys-elevation-level5: 0 8px 12px 6px rgba(0,0,0,0.10), 0 4px 4px 0 rgba(0,0,0,0.08)

  /* MD3 Typography Scale */
  --md-sys-typescale-display-large: 400 3.5625rem/4rem Roboto
  --md-sys-typescale-display-medium: 400 2.8125rem/3.25rem Roboto
  --md-sys-typescale-display-small: 400 2.25rem/2.75rem Roboto
  --md-sys-typescale-headline-large: 400 2rem/2.5rem Roboto
  --md-sys-typescale-headline-medium: 400 1.75rem/2.25rem Roboto
  --md-sys-typescale-headline-small: 400 1.5rem/2rem Roboto
  --md-sys-typescale-title-large: 400 1.375rem/1.75rem Roboto
  --md-sys-typescale-title-medium: 500 1rem/1.5rem Roboto
  --md-sys-typescale-title-small: 500 0.875rem/1.25rem Roboto
  --md-sys-typescale-label-large: 500 0.875rem/1.25rem Roboto
  --md-sys-typescale-label-medium: 500 0.75rem/1rem Roboto
  --md-sys-typescale-label-small: 500 0.6875rem/1rem Roboto
  --md-sys-typescale-body-large: 400 1rem/1.5rem Roboto
  --md-sys-typescale-body-medium: 400 0.875rem/1.25rem Roboto
  --md-sys-typescale-body-small: 400 0.75rem/1rem Roboto

/* An util to define variables that vary with light and dark mode */
define(vars)
  :root
    for key, value in vars
      {key}: value[0]
  :root.dark
    for key, value in vars
      if length(value) > 1
        {key}: value[1]

define({
  --primary: oklch(0.70 0.14 var(--hue)) oklch(0.75 0.14 var(--hue))
  --page-bg: oklch(0.92 0.008 var(--hue)) oklch(0.10 0.006 var(--hue))
  --card-bg: oklch(0.98 0.004 var(--hue)) oklch(0.15 0.012 var(--hue))

  --btn-content: oklch(0.55 0.12 var(--hue)) oklch(0.75 0.1 var(--hue))

  --btn-regular-bg: oklch(0.95 0.025 var(--hue)) oklch(0.33 0.035 var(--hue))
  --btn-regular-bg-hover: oklch(0.9 0.05 var(--hue)) oklch(0.38 0.04 var(--hue))
  --btn-regular-bg-active: oklch(0.85 0.08 var(--hue)) oklch(0.43 0.045 var(--hue))

  --btn-plain-bg-hover: oklch(0.95 0.025 var(--hue)) oklch(0.30 0.035 var(--hue))
  --btn-plain-bg-active: oklch(0.98 0.01 var(--hue)) oklch(0.27 0.025 var(--hue))

  --btn-card-bg-hover: oklch(0.98 0.005 var(--hue)) oklch(0.3 0.03 var(--hue))
  --btn-card-bg-active: oklch(0.9 0.03 var(--hue)) oklch(0.35 0.035 var(--hue))

  --enter-btn-bg: var(--btn-regular-bg)
  --enter-btn-bg-hover: var(--btn-regular-bg-hover)
  --enter-btn-bg-active: var(--btn-regular-bg-active)

  --deep-text: oklch(0.25 0.02 var(--hue))

  --title-active: oklch(0.6 0.1 var(--hue))

  --line-divider: black(0.08) white(0.08)

  --line-color: black(0.1) white(0.1)
  --meta-divider: black(0.2) white(0.2)

  --inline-code-bg: var(--btn-regular-bg)
  --inline-code-color: var(--btn-content)
  --selection-bg: oklch(0.90 0.05 var(--hue)) oklch(0.40 0.08 var(--hue))
  --codeblock-selection: oklch(0.40 0.08 var(--hue))
  --codeblock-bg: oklch(0.17 0.015 var(--hue)) oklch(0.17 0.015 var(--hue))
  --codeblock-topbar-bg: oklch(0.3 0.02 var(--hue)) oklch(0.12 0.015 var(--hue))

  --license-block-bg: black(0.03) var(--codeblock-bg)

  --link-underline: oklch(0.93 0.04 var(--hue)) oklch(0.40 0.08 var(--hue))
  --link-hover: oklch(0.95 0.025 var(--hue)) oklch(0.40 0.08 var(--hue))
  --link-active: oklch(0.90 0.05 var(--hue)) oklch(0.35 0.07 var(--hue))

  --float-panel-bg: oklch(0.90 0.01 var(--hue)) oklch(0.22 0.018 var(--hue))

  --scrollbar-bg-light: black(0.4)
  --scrollbar-bg-hover-light: black(0.5)
  --scrollbar-bg-active-light: black(0.6)

  --scrollbar-bg-dark: white(0.4)
  --scrollbar-bg-hover-dark: white(0.5)
  --scrollbar-bg-active-dark: white(0.6)

  --scrollbar-bg: var(--scrollbar-bg-light) var(--scrollbar-bg-dark)
  --scrollbar-bg-hover: var(--scrollbar-bg-hover-light) var(--scrollbar-bg-hover-dark)
  --scrollbar-bg-active: var(--scrollbar-bg-active-light) var(--scrollbar-bg-active-dark)

  --color-selection-bar: rainbow-light rainbow-dark

  --display-light-icon: 1 0
  --display-dark-icon: 0 1

  --admonitions-color-tip: oklch(0.7 0.14 180) oklch(0.75 0.14 180)
  --admonitions-color-note: oklch(0.7 0.14 250) oklch(0.75 0.14 250)
  --admonitions-color-important: oklch(0.7 0.14 310) oklch(0.75 0.14 310)
  --admonitions-color-warning: oklch(0.7 0.14 60) oklch(0.75 0.14 60)
  --admonitions-color-caution: oklch(0.6 0.2 25) oklch(0.65 0.2 25)

  --toc-badge-bg: oklch(0.89 0.050 var(--hue)) var(--btn-regular-bg)
  --toc-btn-hover: oklch(0.926 0.015 var(--hue)) oklch(0.22 0.02 var(--hue))
  --toc-btn-active: oklch(0.90 0.015 var(--hue)) oklch(0.25 0.02 var(--hue))
  --toc-width: calc((100vw - var(--page-width)) / 2 - 1rem)
  --toc-item-active: oklch(0.70 0.13 var(--hue)) oklch(0.35 0.07 var(--hue))

  --md-sys-color-primary: oklch(0.70 0.14 var(--hue)) oklch(0.75 0.14 var(--hue))
  --md-sys-color-on-primary: #ffffff #1e1e1e
  --md-sys-color-primary-container: oklch(0.91 0.06 var(--hue)) oklch(0.30 0.08 var(--hue))
  --md-sys-color-on-primary-container: oklch(0.35 0.12 var(--hue)) oklch(0.85 0.08 var(--hue))
  --md-sys-color-secondary-container: oklch(0.95 0.025 var(--hue)) oklch(0.33 0.035 var(--hue))
  --md-sys-color-on-secondary-container: oklch(0.55 0.12 var(--hue)) oklch(0.75 0.1 var(--hue))
  --md-sys-color-surface: oklch(0.92 0.008 var(--hue)) oklch(0.10 0.006 var(--hue))
  --md-sys-color-on-surface: oklch(0.12 0.01 var(--hue)) oklch(0.92 0.01 var(--hue))
  --md-sys-color-on-surface-variant: oklch(0.38 0.02 var(--hue)) oklch(0.78 0.02 var(--hue))
  --md-sys-color-outline: oklch(0.50 0.02 var(--hue)) oklch(0.55 0.02 var(--hue))
  --md-sys-color-outline-variant: oklch(0.84 0.015 var(--hue)) oklch(0.32 0.02 var(--hue))

  --md-sys-color-surface-container-lowest: oklch(0.99 0.003 var(--hue)) oklch(0.15 0.012 var(--hue))
  --md-sys-color-surface-container-low: oklch(0.97 0.005 var(--hue)) oklch(0.17 0.014 var(--hue))
  --md-sys-color-surface-container: oklch(0.94 0.008 var(--hue)) oklch(0.19 0.016 var(--hue))
  --md-sys-color-surface-container-high: oklch(0.90 0.01 var(--hue)) oklch(0.22 0.018 var(--hue))
  --md-sys-color-surface-container-highest: oklch(0.86 0.015 var(--hue)) oklch(0.26 0.020 var(--hue))
  --md-sys-color-surface-dim: oklch(0.87 0.01 var(--hue)) oklch(0.06 0.008 var(--hue))
  --md-sys-color-surface-bright: oklch(0.99 0.003 var(--hue)) oklch(0.20 0.014 var(--hue))

  --md-sys-color-surface-tint-color: oklch(0.70 0.14 var(--hue)) oklch(0.75 0.14 var(--hue))
  --md-sys-color-inverse-surface: oklch(0.17 0.015 var(--hue)) oklch(0.90 0.01 var(--hue))
  --md-sys-color-inverse-on-surface: oklch(0.95 0.01 var(--hue)) oklch(0.15 0.02 var(--hue))
  --md-sys-color-inverse-primary: oklch(0.80 0.10 var(--hue)) oklch(0.45 0.12 var(--hue))
  --md-sys-color-shadow: #00000026 #0000004d
  --md-sys-color-scrim: #0000004d #00000099
  --md-sys-color-surface-tint: oklch(0.70 0.14 var(--hue)) oklch(0.75 0.14 var(--hue))
})
